#!/usr/bin/env python3
"""wifi-menu: pick a Wi-Fi network in fuzzel and connect to it (iwd).

Opens when you click the Wi-Fi module in Waybar. You can also run it by hand: wifi-menu

How it works:
	1. Asks iwd over D-Bus (busctl) which networks are around and how strong they are.
	   iwctl prints a colored table, and parsing that would be fragile.
	2. Shows the list in fuzzel and lets you pick one. When iwd knows only one network (often
	   right after connecting), it first waits for a fresh scan, with a progress popup.
	   "Scan again" at the bottom does the same on demand.
	3. Connects right away to known or open networks, otherwise asks for the password.
	   Picking the connected network offers Disconnect / Forget; a saved one, Connect / Forget.
	   (Forget is how you enter a new password when a saved network's password has changed.)
	4. Reports the result as a notification.

Uses only the Python standard library.
"""

import html
import json
import subprocess
import sys
import time

IWD = "net.connman.iwd"
CONNECT_TIMEOUT = 60   # seconds; iwctl normally gives up on its own well before this
SCAN_TIMEOUT = 15     # seconds to wait for a scan before showing what iwd has
ICON_RESCAN = "\U000f0450"   # refresh (Nerd Font)


class Failure(Exception):
	"""Something went wrong; the message is shown to the user."""


def busctl(*args):
	"""Run busctl and return the "data" part of its JSON output."""
	try:
		out = subprocess.run(
			["busctl", "--system", "--json=short", *args],
			capture_output=True, text=True, check=True, timeout=15,
		).stdout
		return json.loads(out)["data"] if out else None
	except (subprocess.CalledProcessError, subprocess.TimeoutExpired, FileNotFoundError, ValueError, KeyError):
		raise Failure("Can't reach iwd. Is it running? (systemctl status iwd)")


def notify(title, body="", critical=False):
	# dunst reads markup (<b>, &...), so text that comes from outside (network names) is escaped
	subprocess.run([
		"notify-send", "-t", "4000",
		"-u", "critical" if critical else "normal",
		"-h", "string:x-dunst-stack-tag:wifi",
		html.escape(title), html.escape(body),
	])


def printable(name):
	"""Network names can hold any bytes. Line breaks or control characters would break the
	one-line-per-network menu, so they are shown as "?". (Only for display: the real name is
	what gets connected to.)"""
	return "".join(c if c.isprintable() else "?" for c in name)


def fuzzel(lines, prompt, password=False):
	"""Open fuzzel as a menu. Return the index of the chosen line (or the typed password).
	Return None if Esc was pressed."""
	if password:
		# Hide the input behind asterisks; --prompt-only: no list, just an input box
		cmd = ["fuzzel", "--dmenu", "--password", f"--prompt-only={prompt}"]
	else:
		# --index: print the index of the chosen line instead of the line itself
		cmd = ["fuzzel", "--dmenu", "--index", "--prompt", prompt,
			"--lines", str(min(len(lines), 10))]
	result = subprocess.run(cmd, input="\n".join(lines), capture_output=True, text=True)
	if result.returncode != 0 or result.stdout.strip() == "":
		return None
	out = result.stdout.rstrip("\n")
	if password:
		return out
	# The index must point at one of our lines (typing text and pressing Enter gives -1)
	try:
		index = int(out)
	except ValueError:
		return None
	return index if 0 <= index < len(lines) else None


def signal_bars(dbm100):
	"""iwd reports signal strength as 100 × dBm (-5500 = -55 dBm). Turn that into 4 bars."""
	dbm = dbm100 / 100
	if dbm > -60:
		full = 4
	elif dbm > -67:
		full = 3
	elif dbm > -75:
		full = 2
	else:
		full = 1
	return "▮" * full + "▯" * (4 - full)


def managed_objects():
	return busctl("call", IWD, "/", "org.freedesktop.DBus.ObjectManager", "GetManagedObjects")[0]


def connect(device, name, kind, known):
	"""Connect with iwctl (asks for the password first if needed). Return the exit code."""
	cmd = ["iwctl"]
	if kind == "psk" and not known:
		password = fuzzel([], f"{printable(name)} password ❯ ", password=True)
		if not password:
			return 0
		# Note: while iwctl runs (a few seconds), the password is part of its command line,
		# which other local users could read from /proc. On a single-user laptop that's fine;
		# avoiding it would mean running an iwd agent over D-Bus, beyond the standard library.
		cmd += ["--passphrase", password]
	elif kind == "8021x" and not known:
		notify("Wi-Fi", f"{name} is an enterprise (802.1x) network. It needs an iwd config file, the menu can't set it up.")
		return 1
	cmd += ["station", device, "connect", name]

	notify("Wi-Fi", f"Connecting to {name}…")
	try:
		result = subprocess.run(cmd, capture_output=True, text=True, timeout=CONNECT_TIMEOUT,
			stdin=subprocess.DEVNULL)   # no terminal: iwctl must not wait for typed input
	except subprocess.TimeoutExpired:
		notify("Wi-Fi", f"Connecting to {name} took too long, gave up.", critical=True)
		return 1
	if result.returncode == 0:
		notify("Wi-Fi", f"Connected to {name}.")
		return 0
	error = (result.stdout + result.stderr).strip() or "unknown error"
	hint = "\nIf its password changed: pick it again and choose Forget." if known else ""
	notify("Wi-Fi", f"Couldn't connect to {name}:\n{error}{hint}", critical=True)
	return 1


def start_scan(station):
	# Fails if a scan is already running, which is fine
	subprocess.run(["busctl", "--system", "call", IWD, station, f"{IWD}.Station", "Scan"],
		capture_output=True)


def wait_for_scan(station):
	"""Wait until iwd's scan is done (at most SCAN_TIMEOUT s), with a progress popup."""
	start = time.monotonic()
	while busctl("get-property", IWD, station, f"{IWD}.Station", "Scanning"):
		elapsed = time.monotonic() - start
		if elapsed > SCAN_TIMEOUT:
			break
		# A scan usually takes about 7 s; the bar stops short of full until it's really done
		progress("Scanning for networks…", min(95, int(elapsed / 7 * 100)))
		time.sleep(0.5)
	progress("Scanning for networks…", 100, timeout=800)


def progress(title, percent, timeout=1500):
	"""A low-urgency popup with a progress bar. Each call replaces the previous one."""
	subprocess.run([
		"notify-send", "-u", "low", "-t", str(timeout),
		"-h", "string:x-dunst-stack-tag:wifi",
		"-h", f"int:value:{percent}",
		title,
	])


def list_networks(station):
	"""Return (networks, lines): the networks iwd knows about, strongest first,
	and one menu line for each."""
	# Networks sorted by signal strength: [[path, signal], ...]
	ordered = busctl("call", IWD, station, f"{IWD}.Station", "GetOrderedNetworks")[0]
	# Read the network details now, so they match the list we just got
	objects = managed_objects()

	networks = []
	lines = []
	for path, signal in ordered:
		net = objects.get(path, {}).get(f"{IWD}.Network")
		if net is None:
			continue
		name = net["Name"]["data"]
		kind = net["Type"]["data"]                 # "psk", "open", "8021x"
		connected = net["Connected"]["data"]
		known = net.get("KnownNetwork", {}).get("data")   # D-Bus path of the saved profile
		lock = "󰌾" if kind != "open" else " "
		status = "  (connected)" if connected else ("  (saved)" if known else "")
		lines.append(f"{signal_bars(signal)}  {lock}  {printable(name)}{status}")
		networks.append((name, kind, connected, known))
	return networks, lines


def main():
	objects = managed_objects()

	# Find the wireless card (station): its name ("wlan0") and its D-Bus path
	station = device = None
	for path, interfaces in objects.items():
		if f"{IWD}.Station" in interfaces:
			station = path
			device = interfaces[f"{IWD}.Device"]["Name"]["data"]
			break
	if station is None:
		notify("Wi-Fi", "No wireless card found.", critical=True)
		return 1

	# Start a new scan. iwd keeps the results of the last one, but right after connecting it
	# often knows only that one network; then the fresh scan (5-8 s) is worth waiting for.
	start_scan(station)
	wait = len(list_networks(station)[0]) <= 1

	while True:
		if wait:
			wait_for_scan(station)
		networks, lines = list_networks(station)
		if not networks:
			notify("Wi-Fi", "No networks found. Try again in a moment.")
			return 0
		lines.append(f"{ICON_RESCAN}  Scan again")

		choice = fuzzel(lines, "Wi-Fi ❯ ")
		if choice is None:
			return 0
		if choice < len(networks):
			break
		start_scan(station)
		wait = True
	name, kind, connected, known = networks[choice]

	# Connected or saved network: ask what to do with it
	if connected or known:
		actions = ["Disconnect"] if connected else ["Connect"]
		if known:
			actions.append("Forget")
		pick = fuzzel(actions, f"{printable(name)} ❯ ")
		if pick is None:
			return 0
		action = actions[pick]
		if action == "Disconnect":
			busctl("call", IWD, station, f"{IWD}.Station", "Disconnect")
			notify("Wi-Fi", f"Disconnected from {name}.")
			return 0
		if action == "Forget":
			busctl("call", IWD, known, f"{IWD}.KnownNetwork", "Forget")
			notify("Wi-Fi", f"Forgot {name}. Pick it again to enter its password.")
			return 0

	return connect(device, name, kind, known)


if __name__ == "__main__":
	try:
		sys.exit(main())
	except Failure as e:
		notify("Wi-Fi", str(e), critical=True)
		sys.exit(1)
